generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(uuid())
  name        String
  tagline     String
  description String   @db.Text
  features    String[]
  icon        String
  status      String   // 'Live' | 'Beta' | 'Coming Soon'
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InsightPost {
  id        String   @id @default(uuid())
  title     String
  excerpt   String   @db.Text
  content   String?  @db.Text
  date      DateTime
  category  String
  readTime  String
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
