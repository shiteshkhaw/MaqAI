# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
# - For local development: http://localhost:3000
# - For production: https://makhijaquantumai.com (or the Vercel frontend URL)
CORS_ORIGIN=http://localhost:3000

# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require&channel_binding=require

# Chatbot AI Fallback (OpenAI / OpenRouter)
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key_here
